{
  "expo": {
    "name": "Christmas Countdown",
    "slug": "christmas-countdown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#061826"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#061826"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-audio",
      "expo-video",
      "expo-file-system",
      "expo-media-library"
    ],
    "scheme": "christmascountdown",
    "extra": {
      "manifestUrl": "https://christmas2026countdown.netlify.app/api/wallpapers"
    }
  }
}
